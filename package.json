{
  "name": "traffic-cutting-up",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "server": "tsx watch server/main.ts",
    "build:server": "tsc --noEmit -p server && vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "start:server": "node dist-server/main.js",
    "netcheck": "tsx scripts/netcheck.ts",
    "bot": "tsx scripts/bot.ts"
  },
  "dependencies": {
    "postprocessing": "^6.39.6",
    "stats-gl": "^4.2.3",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "tweakpane": "^4.0.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
