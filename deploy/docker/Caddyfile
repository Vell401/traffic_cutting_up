# HTTPS in front of the game: the static site from /srv, the WebSocket and /health to the game
# container. There is no domain yet: the certificate is self-signed for the server's IP (deploy.sh
# makes it once), so a browser asks to accept it the first time.
{
	# Browsers send no SNI when the address is an IP: serve this site's certificate anyway.
	default_sni {$SITE_ADDRESS}
	admin off
}

{$SITE_ADDRESS} {
	tls /certs/cert.pem /certs/key.pem
	encode zstd gzip

	# Mutually exclusive handlers keep backend routes out of the static file server.
	# reverse_proxy preserves WebSocket upgrades, Range requests and streamed radio uploads.
	# route prevents Caddy's directive sorting from moving the /miami/* 404 ahead of the proxy.
	route {
		@miami path /miami/ws /miami/health /miami/api /miami/api/*
		handle @miami {
			uri strip_prefix /miami
			reverse_proxy game-miami:8787
		}
		@game path /ws /health /api /api/*
		handle @game {
			reverse_proxy game:8787
		}
		# Miami is selected by /?map=miami in the same build, not a second static tree.
		handle /miami/* {
			respond "Not found" 404
		}
		handle {
			@hashed path /assets/*
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			@page path / /index.html /admin.html /version.json
			header @page Cache-Control "no-cache"
			root * /srv
			file_server
		}
	}
}
